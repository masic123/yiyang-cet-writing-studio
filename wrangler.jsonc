{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cet-writing-studio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [{ "name": "STORE", "class_name": "WritingStore" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WritingStore"] }],
  "vars": {
    "FREE_ACCESS_ENABLED": "true",
    "DEEPSEEK_MODEL": "deepseek-flash",
    "DEEPSEEK_BASE_URL": "https://api.deepseek.com",
    "DAILY_REVIEW_LIMIT": "15",
    "MEMBERSHIP_LAUNCH_DEFERRED": "false",
    "MEMBERSHIP_LAUNCH_AT": "2026-11-02T00:00:00+08:00",
  },
  "observability": { "enabled": false },
}
